# Flask backend URL (default dev port)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# Public app URL (used by keepalive to warm / and /api/health)
# On Vercel, set this to your production domain.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Supabase Auth (required for login / registration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Vercel Cron + GitHub Actions keepalive (server-only — never NEXT_PUBLIC_)
# CRON_SECRET=
# KEEPALIVE_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional Firebase web config for push notifications (Settings page)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FCM_VAPID_KEY=
