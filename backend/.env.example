# ===== Copy to backend/.env (never commit .env). =====
# Server secrets only — put NEXT_PUBLIC_* vars in frontend/.env.local instead.

# --- Groq API (Responder + Get Help Now agent) ---
# Get an API key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
# Voice transcription on /api/transcribe (assessment microphone)
GROQ_WHISPER_MODEL=whisper-large-v3

# --- OpenWeatherMap (Sentinel risk agent) ---
# Free tier key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_key_here

# --- TomTom Traffic (optional — live accidents/congestion on dashboard) ---
# Free dev key at https://developer.tomtom.com
TOMTOM_API_KEY=

# --- Supabase (preferred database — shelters, reports, SOS events) ---
# Run backend/supabase/schema.sql in your Supabase SQL editor first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
POSTGRES_URL=
# Object storage bucket (create via backend/supabase/schema_vectors.sql)
SUPABASE_STORAGE_BUCKET=resq-assets
SUPABASE_MAX_UPLOAD_BYTES=5242880

# --- Triage ML (multilingual Hindi/Telugu classifier, Tier 2.5) ---
TRIAGE_ML_ENABLED=true

# --- Firebase (FCM push notifications; optional Firestore fallback) ---
# Hospitals live in Supabase — seed via scripts/import_hospitals_*.py
# From Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ALERT_TOPIC=resq_alerts
# Optional legacy file path instead of the three vars above:
# FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# --- Vercel Cron / keep-alive (set same value on Vercel + backend host) ---
CRON_SECRET=
KEEPALIVE_SECRET=

# --- App ---
DEFAULT_CITY=Hyderabad
DEFAULT_LAT=17.3850
DEFAULT_LON=78.4867
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# --- Redis Agent Memory (optional — chat assistant session + semantic recall) ---
REDIS_AGENT_MEMORY_KEY=
REDIS_AGENT_MEMORY_URL=https://aws-us-east-1.memory.redis.io
REDIS_AGENT_MEMORY_STORE_ID=

# --- Context Retriever (optional — see ../context-retriever/README.md) ---
# CONTEXT_RETRIEVER_AGENT_KEY=
# CONTEXT_RETRIEVER_SURFACE_ID=
# REDIS_ADDR=redis.example.com:6379
# REDIS_PASSWORD=
